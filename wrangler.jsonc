{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celery-man",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./demo/dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "celeryman.vaporware.gripe",
      "custom_domain": true
    }
  ]
}
